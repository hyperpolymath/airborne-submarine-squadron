# SPDX-License-Identifier: AGPL-3.0-or-later
# Build output (generated by build.sh). `build/` also holds RSR build-orchestration files, so ignore
# its CONTENTS and re-include those.  (The old file ignored `*.wasm`, re-included one wasm, then ignored
# `dist/` wholesale — so the "tracked fallback artifact" could never actually be tracked.)
/build/*
!/build/guix.scm
!/build/README.adoc
/dist/
*.wasm
# ...except test fixtures (the legacy artifact is kept as a NEGATIVE CONTROL for the conformance verifier)
!/test/fixtures/*.wasm

# Backups
.backup/

# Crash logs written by the game server's /crash-report endpoint (directory tracked via logs/.gitkeep)
logs/*.json

# Test / tool output
cov/
_site/
.panic-attack/
reports/

# IDE / AI agent configs (per-user, not tracked)
.claude/
.q/
.junie/
.clinerules
.cursorrules
.windsurfrules
.github/copilot-instructions.md

# Toolchain droppings
target/
node_modules/
_build/
deps/
.elixir_ls/
.cache/
*.log
*.tmp
.DS_Store
Thumbs.db
