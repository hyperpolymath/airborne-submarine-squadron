K9!
# SPDX-License-Identifier: AGPL-3.0-or-later
# coordination.k9 — AI Coordination Protocol for Airborne Submarine Squadron
#
# This file is the single source of truth for all AI agent behaviour.
# Do NOT edit generated files (.cursorrules, AGENTS.md, etc.) directly.
# Edit this file, then re-generate.
#
# Copyright (c) 2026 Jonathan D.A. Jewell (hyperpolymath)

# ── Pedigree (Nickel-syntax preface for k9-validate-action) ─────────
# This block is read by hyperpolymath/k9-validate-action to satisfy the
# contract-validation schema. The YAML body below the --- separator
# carries the actual K9 coordination data; they coexist because the
# validator and the game tooling each parse only their portion.
pedigree = {
  name = "coordination",
  version = "1.0.0",
  leash = "kennel",
  schema_version = "1.0.0",
  signature = "none",
}

---
metadata:
  schema: k9-coordination
  schema_version: 1.0.0
  generated_by: k9-coordination-generator
  last_updated: 2026-09-29

project:
  name: "Airborne Submarine Squadron"
  description: "Sopwith-inspired arcade game where a zeppelin launches attack submarines that fly, dive, and torpedo. Browser-based with system tray integration."
  license: AGPL-3.0-or-later
  repo: "hyperpolymath/airborne-submarine-squadron"
  languages:
    - JavaScript
    - AffineScript
    - Rust
    - HTML
    - CSS
  build_system: just
  runtime: deno

build_commands:
  just build: "Build AffineScript to WASM"
  just serve: "Start Deno file server on port 6880"
  just install: "Install desktop integration (XDG .desktop file)"
  just tray: "Build and run Rust system tray binary"

invariants:
  - id: no-typescript
    rule: "Do not introduce TypeScript files anywhere"
    reason: "Vanilla JavaScript and AffineScript are the chosen languages — TypeScript is banned across all hyperpolymath repos"
    severity: critical

  - id: no-tauri-electron
    rule: "Do not introduce Tauri, Electron, or any desktop framework"
    reason: "Architecture is deliberately browser + system tray binary (Gossamer frontend + Rust ksni tray). This is intentional, not a gap to fill."
    severity: critical

  - id: bun-only-runtime
    rule: "Bun is the only permitted JS runtime, test runner and package manager — no Deno, Node.js, npm, yarn or pnpm"
    reason: "Estate LANGUAGE-POLICY (owner ruling 2026-09-22): Bun is tier 1 and Deno is banned. Supersedes the April 2026 Deno-only rule. The game server (run.js + server/ass-server.js) and the whole test suite run on Bun."
    severity: critical

  - id: package-manifest-policy
    rule: "package.json IS expected (Bun manifest: private, type=module, ZERO dependencies). Do not create package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, deno.json, deno.lock or node_modules"
    reason: "The game ships dependency-free; a runtime dependency needs an explicit owner decision. test/contract_test.js enforces this."
    severity: critical

  - id: port-6880
    rule: "Default development port is 6880"
    reason: "688 references the Type 688 Los Angeles-class attack submarine — this is a deliberate thematic choice, not arbitrary"
    severity: moderate

  - id: affinescript-engine
    rule: "The game engine will be AffineScript compiled to WASM — do not replace with a JS game engine"
    reason: "AffineScript is a hyperpolymath language (from nextgen-languages). The authoritative simulation migrates to AffineScript/typed-WASM via the strangler plan in docs/AFFINESCRIPT-PORT-PLAN.adoc; the JS engine stays as renderer/host until each subsystem is proven equivalent (sim/verify_artifact.js)."
    severity: critical

  - id: standalone-repo
    rule: "This is a standalone git repository — do not merge into a monorepo"
    reason: "Co-developed with son, AGPL-licensed (exception to PMPL), independent history"
    severity: critical

  - id: agpl-license
    rule: "This project is AGPL-3.0-or-later — do not change the license"
    reason: "Co-developed with son, AGPL chosen deliberately. This is an exception to the normal MPL-2.0 policy."
    severity: critical

protected:
  - path: gossamer/
    reason: "Gossamer frontend — HTML5 Canvas game rendering and UI"
  - path: tray/
    reason: "Rust system tray binary using ksni (KDE StatusNotifierItem)"
  - path: src/
    reason: "AffineScript source — main.affine is the game-core source"
  - path: server/
    reason: "Bun game server (allowlisted static files, same-origin guard, bounded uploads) — security-tested in test/server_test.js"
  - path: sim/
    reason: "Reference twin, golden vectors and the WASM conformance verifier — the oracle any AffineScript build must match"
  - path: build/
    reason: "Generated WASM output (gitignored) + build/guix.scm — the directory must exist"
  - path: launcher.sh
    reason: "Unified launcher script — entry point for the whole application"
  - path: .machine_readable/
    reason: "Canonical location for all A2ML state files — never move to root"
  - path: coordination.k9
    reason: "This file — source of truth for AI coordination"

architecture:
  - id: browser-plus-tray
    decision: "Game runs in browser window, with a separate Rust system tray binary for desktop integration"
    reason: "Lightweight, no heavy framework dependency, works on Wayland/KDE natively via ksni"
    alternatives_rejected:
      - Tauri
      - Electron
      - native GTK application

  - id: affinescript-to-wasm
    decision: "Game logic written in AffineScript, compiled to WASM, loaded by browser"
    reason: "AffineScript is a hyperpolymath language with linear types — proves resource safety in game logic"
    alternatives_rejected:
      - Pure JavaScript game engine
      - Rust compiled to WASM
      - Unity/Godot

  - id: gossamer-frontend
    decision: "Gossamer provides the desktop window (WebKitGTK-based)"
    reason: "Gossamer is the hyperpolymath desktop runtime — shared with PanLL and other projects"

  - id: bun-game-server
    decision: "Bun serves the game (run.js + server/ass-server.js): allowlisted static files, same-origin guard, bounded uploads, groove manifest"
    reason: "Estate runtime (LANGUAGE-POLICY 2026-09-22), zero dependencies. Replaced the Deno server AND the two embedded heredoc servers in launcher.sh / gossamer/launch.sh (one of which accepted path traversal)."
    alternatives_rejected:
      - Deno (banned 2026-09-22)
      - Python http.server
      - Node.js
      - nginx

do_not_create:
  - pattern: "**/*.ts"
    reason: "TypeScript is banned — use vanilla JS or AffineScript"
  - pattern: "Dockerfile"
    reason: "Use Containerfile (Podman, not Docker)"
  - pattern: "deno.json"
    reason: "Deno is banned (2026-09-22) — the Bun manifest is package.json"
  - pattern: "package-lock.json"
    reason: "npm lock files banned (bun.lock is the lockfile if dependencies are ever added)"
  - pattern: "node_modules/**"
    reason: "npm ecosystem banned"
  - description: "Any heavyweight game framework (Phaser, PixiJS, Three.js)"
    reason: "Game engine is AffineScript→WASM — JS frameworks are not needed"
  - description: "Alternative launcher or desktop entry system"
    reason: "launcher.sh + .desktop file is the intended approach"
  - description: "Electron or Tauri wrapper"
    reason: "Gossamer + Rust tray is the architecture"

terminology:
  - correct: "attack submarine"
    incorrect:
      - submarine
      - plane
      - aircraft
    context: "The flying vehicles are attack submarines launched from a zeppelin — this is the core game concept"

ports:
  dev-server: 6880

ecosystem:
  depends_on:
    - name: metadatastician/gossamer
      role: "Desktop window runtime (WebKitGTK + Zig); linear-typed shell"
    - name: hyperpolymath/affinescript
      role: "AffineScript compiler (core WASM + typed-wasm ownership verifier)"
  planned:
    - name: metadatastician/enaction-engine
      role: "Deterministic fixed-step timing (enaction-time) — gossamer/fixed_step.js already implements its contract in JS"
    - name: metadatastician/groove
      role: "Capability discovery: ASS serves /.well-known/groove (mode active)"
    - name: metadatastician/spline
      role: "Typed wire (Bebop control plane) for multiplayer snapshots — replaces JSON over DataChannel"
    - name: metadatastician/cleave
      role: "Integration dial: raw FFI <-> SNIF sandbox <-> protocol; the sim kernel is the first real consumer"
    - name: metadatastician/burble
      role: "Voice for squadron/role-based shared-sub multiplayer"
  related:
    - name: metadatastician/IDApTIK
      role: "Sister game project — also Gossamer + AffineScript; proving ground for the deterministic-core pattern"
    - name: metadatastician/universal-modding-studio
      role: "Authoring/packaging for mods; ASS would be its next game profile after IDApTIK and Chronicles of Slavia"
    - name: proven
      role: "Formal verification — AffineScript type proofs"
